	file = {PubMed Central Full Text PDF:C\:\\Users\\Chris DeMaio\\Zotero\\storage\\6C5VGUVZ\\Gilbert and Webster - 2016 - Rapid, Reliable Shape Setting of Superelastic Niti.pdf:application/pdf},
}

@article{morimoto_design_2016,
	title = {Design of 3-{D} {Printed} {Concentric} {Tube} {Robots}},
	volume = {32},
	issn = {1552-3098, 1941-0468},
	url = {http://ieeexplore.ieee.org/document/7575665/},
	doi = {10.1109/TRO.2016.2602368},
	abstract = {Concentric tube surgical robots are minimally invasive devices with the advantages of snake-like reconﬁgurability, long and thin form factor, and placement of actuation outside the patient’s body. These robots can also be designed and manufactured to acquire targets in speciﬁc patients for treating speciﬁc diseases in a manner that minimizes invasiveness. We propose that concentric tube robots can be manufactured using 3-D printing technology on a patient- and procedure-speciﬁc basis. In this paper, we deﬁne the design requirements and manufacturing constraints for 3-D printed concentric tube robots and experimentally demonstrate the capabilities of these robots. While numerous 3-D printing technologies and materials can be used to create such robots, one successful example uses selective laser sintering to make an outer tube with a polyether block amide and uses stereolithography to make an inner tube with a polypropylene-like material. This enables a tube pair with precurvatures of 0.0775 and 0.0455 mm−1 , which can withstand strains of 20\% and 5.5\% for the outer and inner tubes, respectively.},
	language = {en},
	number = {6},
	urldate = {2023-10-24},
	journal = {IEEE Transactions on Robotics},
	author = {Morimoto, Tania K. and Okamura, Allison M.},
	month = dec,
	year = {2016},
	pages = {1419--1430},
	file = {Morimoto and Okamura - 2016 - Design of 3-D Printed Concentric Tube Robots.pdf:C\:\\Users\\Chris DeMaio\\Zotero\\storage\\H787JWGU\\Morimoto and Okamura - 2016 - Design of 3-D Printed Concentric Tube Robots.pdf:application/pdf},
}

@article{vandini_unified_2017,
	title = {Unified {Tracking} and {Shape} {Estimation} for {Concentric} {Tube} {Robots}},
